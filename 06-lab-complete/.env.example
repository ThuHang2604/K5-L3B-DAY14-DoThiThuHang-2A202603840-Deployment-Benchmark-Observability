# Copy thành .env rồi điền giá trị thật:  cp .env.example .env
# (.env đã nằm trong .gitignore và .dockerignore — KHÔNG commit)

# Server
PORT=8000
ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO
WEB_CONCURRENCY=2              # số uvicorn worker trong container

# Security — bắt buộc khi ENVIRONMENT=production. Tạo key: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_API_KEY=

# State store (rate limit + cost guard)
REDIS_URL=redis://localhost:6379/0

# Rate limit: số request / 60 giây cho mỗi API key
RATE_LIMIT_PER_MINUTE=10

# Cost guard (USD)
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=10.0
